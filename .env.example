# Copy to .env.development.local or configure Netlify's build environment.
REACT_APP_USE_MOCK=false
# Production requires a verified HTTPS backend (do not merely change http to https).
REACT_APP_API_BASE_URL=http://localhost:8080
# Public browser keys only; restrict origins and APIs in provider consoles.
REACT_APP_GOOGLE_MAPS_BROWSER_KEY=
REACT_APP_KAKAO_MAP_JS_KEY=

# Local-only ranking preview: 10 synthetic cities + 7 synthetic places.
# Never merges demo engagement into live API or creates real user activity.
REACT_APP_RANKINGS_DEMO=false
