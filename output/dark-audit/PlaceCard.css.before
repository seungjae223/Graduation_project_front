.place-card {
  overflow: hidden;
  border-radius: 20px;
  background: #ffffff;
  border: 1px solid #edf1f6;
  box-shadow: 0 2px 10px rgba(19, 33, 61, 0.05);
}

.place-image-wrap {
  position: relative;
}

.place-image {
  display: block;
  width: 100%;
  height: 210px;
  object-fit: cover;
  background: #f4f6f9;
}

.place-heart-btn {
  position: absolute;
  top: 14px;
  right: 14px;
  width: 42px;
  height: 42px;
  border: none;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 2px 8px rgba(19, 33, 61, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

.heart-icon {
  width: 22px;
  height: 22px;
}

.place-content {
  padding: 16px;
}

.place-badge {
  display: inline-flex;
  align-items: center;
  height: 24px;
  padding: 0 10px;
  border-radius: 999px;
  background: #eaf6fd;
  color: #18a0f5;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.03em;
}

.place-title {
  margin: 12px 0 6px;
  font-size: 18px;
  font-weight: 800;
  color: #15213b;
}

.place-address {
  margin: 0 0 12px;
  color: #7a879c;
  font-size: 15px;
}

.place-rating {
  display: flex;
  align-items: center;
  gap: 4px;
  margin-bottom: 16px;
  font-size: 16px;
  font-weight: 700;
  color: #15213b;
}

.star {
  color: #ffbf1a;
}

.review-count {
  color: #97a3b6;
  font-weight: 600;
}

.route-add-btn {
  width: 100%;
  height: 46px;
  border: none;
  border-radius: 12px;
  background: #18a0f5;
  color: #ffffff;
  font-size: 16px;
  font-weight: 700;
  cursor: pointer;
}