+++ b/src/test/java/com/nomango/nomango/controller/KakaoRedirectFlowTest.java
@@ -0,0 +1,110 @@
+package com.nomango.nomango.controller;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.nomango.nomango.dto.SocialLoginResponseDto;
+import com.nomango.nomango.service.*;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.http.MediaType;
+import org.springframework.test.web.client.MockRestServiceServer;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.setup.MockMvcBuilders;
+import org.springframework.web.client.RestClient;
+import org.springframework.web.util.UriComponentsBuilder;
+
+import java.net.URLEncoder;
+import java.nio.charset.StandardCharsets;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.hamcrest.Matchers.containsString;
+import static org.mockito.ArgumentMatchers.*;
+import static org.mockito.Mockito.*;
+import static org.springframework.test.web.client.match.MockRestRequestMatchers.*;
+import static org.springframework.test.web.client.response.MockRestResponseCreators.withSuccess;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.*;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+// Real controller, URI policy, per-state storage and HTTP client. Only provider
+// HTTP responses and user persistence are substituted; this is not a real login.
+class KakaoRedirectFlowTest {
+    private static final String LOCAL = "http://localhost:3000/oauth/kakao/callback";
+    private static final String DEPLOYED = "https://noman-go.netlify.app/oauth/kakao/callback";
+    private final ObjectMapper json = new ObjectMapper();
+    private MockMvc mvc;
+    private MockRestServiceServer provider;
+
+    @BeforeEach
+    void setUp() {
+        RestClient.Builder builder = RestClient.builder();
+        provider = MockRestServiceServer.bindTo(builder).build();
+        var client = new KakaoOAuthClient(builder, "test-client", "", DEPLOYED);
+        var users = mock(SocialLoginUserService.class);
+        when(users.loginOrCreate(any(), anyString(), any(), any()))
+                .thenReturn(new SocialLoginResponseDto("test-only-jwt", "Bearer", false));
+        var kakao = new KakaoLoginService(client, new OAuthStateService(), users,
+                new KakaoRedirectUriPolicy(DEPLOYED, LOCAL + "," + DEPLOYED));
+        mvc = MockMvcBuilders.standaloneSetup(new AuthController(mock(SignupService.class),
+                        mock(LoginService.class), kakao, mock(GoogleLoginService.class), mock(PasswordResetService.class)))
+                .setControllerAdvice(new GlobalExceptionHandler()).build();
+    }
+
+    private String authorize(String requested, String expected) throws Exception {
+        var request = get("/api/auth/kakao/authorize");
+        if (requested != null) request.param("redirectUri", requested);
+        var result = mvc.perform(request).andExpect(status().isOk()).andReturn();
+        var body = json.readTree(result.getResponse().getContentAsString());
+        var params = UriComponentsBuilder.fromUriString(body.path("authorizationUrl").asText()).build().getQueryParams();
+        assertThat(params.getFirst("redirect_uri")).isEqualTo(expected);
+        return body.path("state").asText();
+    }
+
+    private void expectExchange(String redirectUri) {
+        provider.expect(requestTo("https://kauth.kakao.com/oauth/token"))
+                .andExpect(content().string(containsString("redirect_uri=" + URLEncoder.encode(redirectUri, StandardCharsets.UTF_8))))
+                .andRespond(withSuccess("{\"access_token\":\"test-only-provider-token\"}", MediaType.APPLICATION_JSON));
+        provider.expect(requestTo("https://kapi.kakao.com/v2/user/me"))
+                .andRespond(withSuccess("{\"id\":\"123\",\"kakao_account\":{\"profile\":{\"nickname\":\"Tester\"}}}", MediaType.APPLICATION_JSON));
+    }
+
+    private void login(String state, String attemptedOverride) throws Exception {
+        var body = json.createObjectNode().put("code", "test-only-code").put("state", state);
+        // This field is deliberately outside the login DTO. It cannot override state.
+        body.put("redirectUri", attemptedOverride);
+        mvc.perform(post("/api/auth/kakao/login").contentType(MediaType.APPLICATION_JSON).content(json.writeValueAsBytes(body)))
+                .andExpect(status().isOk());
+    }
+
+    @Test
+    void localAndDeploymentAttemptsKeepTheirOwnUriEvenWhenCompletedInReverseOrder() throws Exception {
+        String localState = authorize(LOCAL, LOCAL);
+        String deployedState = authorize(DEPLOYED, DEPLOYED);
+        expectExchange(DEPLOYED);
+        expectExchange(LOCAL);
+        login(deployedState, "https://outside.example/oauth/kakao/callback");
+        login(localState, DEPLOYED);
+        provider.verify();
+        mvc.perform(post("/api/auth/kakao/login").contentType(MediaType.APPLICATION_JSON)
+                        .content(json.writeValueAsBytes(json.createObjectNode().put("code", "test-only-code").put("state", localState))))
+                .andExpect(status().isBadRequest());
+    }
+
+    @Test
+    void oldDeploymentClientWithoutParameterKeepsDeploymentCallback() throws Exception {
+        String state = authorize(null, DEPLOYED);
+        expectExchange(DEPLOYED);
+        login(state, LOCAL);
+        provider.verify();
+    }
+
+    @Test
+    void untrustedCallbackAndMissingOrUnknownStateFailBeforeProviderRequests() throws Exception {
+        mvc.perform(get("/api/auth/kakao/authorize").param("redirectUri", "https://outside.example/oauth/kakao/callback"))
+                .andExpect(status().isBadRequest());
+        for (String state : new String[]{"", "unknown"}) {
+            mvc.perform(post("/api/auth/kakao/login").contentType(MediaType.APPLICATION_JSON)
+                            .content(json.writeValueAsBytes(json.createObjectNode().put("code", "test-only-code").put("state", state))))
+                    .andExpect(status().isBadRequest());
+        }
+        provider.verify();
+    }
+}
