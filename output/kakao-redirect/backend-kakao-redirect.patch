+package com.nomango.nomango.service;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+
+import static org.assertj.core.api.Assertions.*;
+
+class KakaoRedirectUriPolicyTest {
+    private static final String LOCAL = "http://localhost:3000/oauth/kakao/callback";
+    private static final String DEPLOYED = "https://noman-go.netlify.app/oauth/kakao/callback";
+    private final KakaoRedirectUriPolicy policy = new KakaoRedirectUriPolicy(DEPLOYED, LOCAL + ", " + DEPLOYED);
+
+    @Test
+    void exactLocalAndDeploymentUrisAreAllowedAndOmissionKeepsLegacyDefault() {
+        assertThat(policy.resolve(LOCAL)).isEqualTo(LOCAL);
+        assertThat(policy.resolve(DEPLOYED)).isEqualTo(DEPLOYED);
+        assertThat(policy.resolve(null)).isEqualTo(DEPLOYED);
+    }
+
+    @ParameterizedTest
+    @ValueSource(strings = {"", " ", "https://outside.example/oauth/kakao/callback",
+            "//noman-go.netlify.app/oauth/kakao/callback",
+            "https://noman-go.netlify.app.evil.example/oauth/kakao/callback",
+            "https://user@noman-go.netlify.app/oauth/kakao/callback",
+            "http://localhost:3001/oauth/kakao/callback", "http://127.0.0.1:3000/oauth/kakao/callback",
+            "http://localhost:3000/oauth/kakao/callback/", "http://localhost:3000/oauth/kakao/callback?next=outside",
+            "http://localhost:3000/oauth/kakao/callback#fragment", "http://localhost:3000/oauth/google/callback"})
+    void arbitraryOrModifiedUrisAreRejected(String requested) {
+        assertThatThrownBy(() -> policy.resolve(requested)).isInstanceOf(IllegalArgumentException.class);
+    }
+
+    @Test
+    void defaultMustAlsoBeExplicitlyAllowed() {
+        var restricted = new KakaoRedirectUriPolicy(DEPLOYED, LOCAL);
+        assertThatThrownBy(() -> restricted.resolve(null)).isInstanceOf(IllegalArgumentException.class);
+    }
+}
